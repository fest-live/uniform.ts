{
    "include": [
        "./src/**/*.ts",
        "./test/**/*.ts",
        "./src/$core/*.ts",
        "./src/$wrap/*.ts"
    ],
    "exclude": [
        "./dist/**/*",
        "./externals/**/*",
        "./src/**/*.js",
        "./src/**/*.jsx"
    ],
    "compilerOptions": {
        "outDir": "./dist/",
        "paths": {
            "@fest-lib/*": [
                "../../shared/fest/*",
                "./node_modules/@fest-lib/*"
            ],
            "@fest-lib/core": [
                "../core.ts/src/index.ts",
                "./node_modules/@fest-lib/core/src/index.ts"
            ],
            "@fest-lib/uniform": [
                "./src/index.ts",
                "./node_modules/@fest-lib/uniform/src/index.ts"
            ],
            "@fest-lib/polyfill/*": [
                "../../shared/fest/polyfill/*",
                "./node_modules/@fest-lib/polyfill/*/src/index.ts"
            ],
            "polyfill/*": [
                "../../shared/fest/polyfill/*",
                "./node_modules/polyfill/*/src/index.ts"
            ]
        },
        "target": "ESNext",
        "module": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "ESNext.Promise"
        ],
        "types": [
            "chrome"
        ],
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "declaration": false,
        "noImplicitThis": false,
        "inlineSources": true,
        "inlineSourceMap": true,
        "sourceMap": false,
        "experimentalDecorators": true,
        "moduleDetection": "force",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
